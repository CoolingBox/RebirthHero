# ============================================================
# 《轮回大侠》 Godot 4.7 + C# (.NET 8)  .gitignore
# 原则：源码 / 场景 / 配置表(Resources/Config/*.json) / 生成的 C# 配置类 / *.uid 一律入库；
#       引擎缓存、编译产物、IDE 配置、临时脚本不入库。
# ============================================================

# ---------- Godot 4 自动生成的缓存与导入产物 ----------
# 资源导入缓存 + C# 编译中间产物（.godot/mono/temp）都在这里，删除后编辑器可重建
.godot/

# ---------- 导出 ----------
# 导出预设可能含签名/密码，且各机器路径不同（若想版本化导出设置，删掉这行）
export_presets.cfg
export.cfg
# 从 CSV 自动生成的翻译资源
*.translation
# 平台导出目录
/android/
/build/
/dist/

# ---------- .NET / C# 构建产物 ----------
bin/
obj/
.vs/
*.user
*.suo
*.userprefs
# Godot 3 时代的 Mono 产物（无害保留）
.mono/
data_*/
mono_crash.*.json

# ---------- IDE ----------
# JetBrains Rider / Godot 联动生成的工程配置
.idea/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本项目：临时 / 探针脚本 ----------
# .codebuddy/tools/ 是开发工具（GenConfig.py / GenUICode.py），**要入库**；
# .codebuddy/tmp/ 是一次性脚本 / 探针草稿，**不入库**。
.codebuddy/tmp/
# .codebuddy/memory/ 是 AI 工具的历史记忆，非项目源码，不入库。
.codebuddy/memory/

# ============================================================
# 注意：**不要**把 *.uid 加进忽略列表。
# Godot 4.4+ 的脚本/资源 .uid 必须入库，否则换机器或重命名后场景引用会断。
# ============================================================
