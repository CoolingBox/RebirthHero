# ============================================================
# 《轮回大侠》行尾 / 文件类型规则
# 目标：文本文件在「仓库 + 工作区」统一为 LF；资源标记为二进制，不做行尾与 diff 转换。
# 说明：eol 属性会覆盖 core.autocrlf，所以本仓库不再受系统级 autocrlf=true 影响。

# 默认：所有文本按 LF 处理（未显式声明的文本类型走这条）
* text=auto eol=lf
# ---------- 文本（显式声明，避免被误判）----------
*.cs            text eol=lf
*.py            text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.tscn          text eol=lf
*.tres          text eol=lf
*.uid           text eol=lf
*.godot         text eol=lf
*.cfg           text eol=lf
*.import        text eol=lf
*.svg           text eol=lf
*.editorconfig  text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
# ---------- 资源 / 编译产物：二进制 ----------
# Godot 产物与素材
*.res       binary
*.scn       binary
*.escn      binary
*.pck       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.bmp       binary
*.tga       binary
*.exr       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.wav       binary
*.ogg       binary
*.mp3       binary
*.flac      binary
# 配置源表 / .NET 构建产物
*.xlsx      binary
*.xls       binary
*.zip       binary
*.dll       binary
*.pdb       binary
*.exe       binary
*.so        binary
*.dylib     binary
# Git LFS（2026-11-05）
#
# 为什么只有这几类：仓库里 ≥512KB 的文件共 77 个、占 151MB（97%），
# 全是 png / ttf / mp3。文本、.import、.uid、配置 JSON 一律不进 LFS ——
# LFS 对小文件是负收益（每个文件一个指针 + 一次 LFS 请求）。
# ⚠️ 克隆前必须先装 git-lfs 并 `git lfs install`，
#    否则素材会以指针文本形式落地，Godot 导入直接报错。
# ⚠️ 这几条必须放在文件**末尾**：git 的规则是"后面的赢"，
#    上面 `*.png binary` 会设 -diff -merge，LFS 的 merge=lfs 必须在它之后才生效。
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text
